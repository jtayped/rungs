FROM node:22-bookworm-slim AS base
RUN npm install -g pnpm@11.26.0
WORKDIR /repo

# Manifests first, so a source-only change reuses the install layer.
FROM base AS build
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/api/package.json apps/api/
COPY tooling/eslint/package.json tooling/eslint/
COPY tooling/typescript/package.json tooling/typescript/
RUN pnpm install --frozen-lockfile --filter @rungs/api...
COPY . .
RUN pnpm --filter @rungs/api build
RUN pnpm --filter @rungs/api deploy --prod --legacy /out

FROM node:22-bookworm-slim
ARG RUNGS_COMMIT=dev
ENV NODE_ENV=production PORT=3001 RUNGS_COMMIT=$RUNGS_COMMIT
WORKDIR /app
COPY --from=build --chown=node:node /out/package.json ./
COPY --from=build --chown=node:node /out/node_modules ./node_modules
COPY --from=build --chown=node:node /repo/apps/api/dist ./dist
USER node
EXPOSE 3001
HEALTHCHECK --interval=30s --timeout=5s --retries=3 CMD ["node", "-e", "fetch('http://localhost:3001/health').then((r) => process.exit(r.ok ? 0 : 1), () => process.exit(1))"]
CMD ["node", "dist/index.mjs"]
