# Only needed if you are NOT starting via `pnpm dev`.
#
# `pnpm dev` runs the API under:
#   secret-run personal rungs.openrouter -- tsx watch src/index.ts
# which injects the key from the encrypted scope, so nothing lands on disk.
#
# For the plain path, copy this file to apps/api/.env.local, paste the key and
# run `pnpm --filter @rungs/api dev:env`. .env.local is gitignored.

OPENROUTER_API_KEY=sk-or-v1-...
PORT=3001

# Optional in dev: these default to compose.dev.yaml's Postgres and a
# throwaway secret. Required in production.
# DATABASE_URL=postgres://rungs:rungs@localhost:5434/rungs
# BETTER_AUTH_SECRET=  # openssl rand -base64 32

# Without a Resend key, sign-in codes are printed to the api's console.
# RESEND_API_KEY=re_...
# EMAIL_FROM=rungs <rungs@joeltaylor.business>
# SITE_URL=http://localhost:3000
