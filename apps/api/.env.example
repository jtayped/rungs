# Copy this file to apps/api/.env.local and paste the key. `pnpm dev` and
# `pnpm --filter @rungs/api probe` read it, unless secret-run is installed, in
# which case they take the key from its encrypted scope and nothing lands on
# disk. .env.local is gitignored.

OPENROUTER_API_KEY=sk-or-v1-...
PORT=3001

# Optional in dev: these default to compose.dev.yaml's Postgres, a throwaway
# secret and the local web app. Required in production.
# DATABASE_URL=postgres://rungs:rungs@localhost:5434/rungs
# BETTER_AUTH_SECRET=  # openssl rand -base64 32
# SITE_URL=http://localhost:3000

# Without a Resend key, sign-in codes are printed to the api's console.
# RESEND_API_KEY=re_...
# EMAIL_FROM=rungs <rungs@joeltaylor.business>
